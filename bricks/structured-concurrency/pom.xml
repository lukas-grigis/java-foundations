<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.lukasgrigis.foundations</groupId>
    <artifactId>structured-concurrency</artifactId>
    <version>0.1.0</version>
    <name>structured-concurrency</name>

    <description>
        Java Foundations, the structured-concurrency brick, StructuredTaskScope (JEP 533, seventh preview, JDK 27)
        vs. hand-rolled ExecutorService fan-out. PREVIEW API: this brick compiles and runs only on JDK 27 with
        --enable-preview, and the API can still change before it is final (JEP 543, targeted for JDK 28). Pure
        JDK, no dependencies.
    </description>

    <properties>
        <maven.compiler.release>27</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- No dependencies: the whole point is what the language does on its own. -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>27</release>
                    <enablePreview>true</enablePreview>
                    <compilerArgs>
                        <arg>-Xlint:all,-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
